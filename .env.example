# Facebook Scraper - Variables de Entorno
# Copia este archivo como .env y configura tus valores

# Credenciales de Facebook (opcional - para posts privados)
FACEBOOK_EMAIL=tu_email@ejemplo.com
FACEBOOK_PASSWORD=tu_password

# Configuracion del navegador
HEADLESS_MODE=False

# Delays anti-bloqueo (en segundos)
DELAY_MIN=3
DELAY_MAX=7

# Reintentos
MAX_RETRIES=3

# Descarga de imagenes
DOWNLOAD_TIMEOUT=30
IMAGE_QUALITY=high
DOWNLOAD_IMAGES=True
